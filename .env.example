# HydraDB graph-node (see the HydraDB repo's own README for how to bring one
# up locally with `docker run ghcr.io/hydra-db/hydradb`)
HYDRADB_HTTP_URL=http://127.0.0.1:8443
HYDRADB_ADMIN_URL=http://127.0.0.1:9090
HYDRADB_AUTH_TOKEN=local-development-token-32-bytes
HYDRADB_NAMESPACE=default
HYDRADB_GRAPH=default
HYDRADB_CELL_ID=cell-0

# deps.dev, npm registry, PyPI, and OSV.dev are all unauthenticated public
# APIs (src/lib/depsdev.ts, registry.ts, osv.ts) — nothing to configure.
